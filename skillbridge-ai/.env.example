# Optional: without these, the app uses local practice mode.
MONGODB_URI=
MONGODB_DB=skillbridge
# Any OpenAI-compatible chat completions provider:
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Optional recurring billing. Create a monthly INR 399 plan in Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# One AI question, feedback response, or coach reply counts as a request.
AI_MONTHLY_REQUEST_LIMIT=300
# Set this to your HTTPS production address for deployment checks.
APP_URL=
